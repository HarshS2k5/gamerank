# RAWG Video Games Database API Key
# Get your free API key at: https://rawg.io/apidocs
# Sign up at https://rawg.io/login and go to your profile to get the API key
RAWG_API_KEY=your_rawg_api_key_here

# Site URL (used for OpenGraph and sitemaps)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to production URL when deploying
# NEXT_PUBLIC_SITE_URL=https://your-gamerank-domain.com
